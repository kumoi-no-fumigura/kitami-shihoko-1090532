 "blocks": [
  {
   "id": "kitami-shihoko-1090532-0001",
   "pid": "1090532",
   "pages": [
    8
   ],
   "no": null,
   "maki": "早春譜（大正六年―九年）",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "早口繪·月光菩薩像朝小秋島土佐ののの庭路町海大湧谷に行くとて卷箱根游行晩末のの春に秋顏庭路町譜二一〇二〇五二〇三二〇一一九七一五五一九",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0002",
   "pid": "1090532",
   "pages": [
    9
   ],
   "no": null,
   "maki": "早春",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "早春道のべの枯れ芝中の細つばなほのかに赤く芽ぶき初めたり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0003",
   "pid": "1090532",
   "pages": [
    10
   ],
   "no": null,
   "maki": "早春",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ふるさとの我家のせどの細つばなことしもはやく萠えにけむかもうららかに春日きらへばあげひばり靑麥畑にけふも來鳴けりきぞの夜ふりける雨に裏畑の苺の新芽いやのびにけりねぎごとを心にもちてゆく道に雲雀あがれりこゑもうららに",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0004",
   "pid": "1090532",
   "pages": [
    11
   ],
   "no": null,
   "maki": "遠田の蛙",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "野田つづく馬込の村の夕あかり蛙の聲はすみこもりゐの心わびしも裏にでて毒だみの花ふてきこゆるみにじりたり遠田の蛙",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0005",
   "pid": "1090532",
   "pages": [
    12
   ],
   "no": null,
   "maki": "歸心",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "歸心幾とせを山の峽間に吾をまてる母に會はむとひとりかへるも木立ふかみ水の音する山のべに母にあはむと一人ゆく我は鬼あざみほのかにさける切りそぎの山のはり道ゆけばしたしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0006",
   "pid": "1090532",
   "pages": [
    13
   ],
   "no": null,
   "maki": "夕月夜",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "白く光りて夕月夜はぎのうれ葉におく露の風ふけば散るさきいでし萩の葉末にしら露のこぼれんとし月て灯に光りゐるタ夜",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0007",
   "pid": "1090532",
   "pages": [
    14
   ],
   "no": null,
   "maki": "曇り日の河原",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "多摩川の淺川〓みたぎつ瀨の音をききつつ船橋わたる船橋の船腹たたくさざ波をかなしとみつつひとり渡るも多摩川の秋雨さむみここだくもならびて下る筏の船は曇り日の河原",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0008",
   "pid": "1090532",
   "pages": [
    15
   ],
   "no": null,
   "maki": "雪と七面鳥",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "船まつと河原にたてば行軍の兵隊きたる秋雨はだら雪消えのこりたるふしん場をしづかにあゆむ七面鳥はにぬれて雪と七面鳥",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0009",
   "pid": "1090532",
   "pages": [
    16
   ],
   "no": null,
   "maki": "兄と弟",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あわ雪の消えのこりたる庭かげにひそやかに立つ七面鳥のつがひ朝なぎにふりける雪はおのづから檜ばらの上につもりゆくみゆ兄みとりすとかへりはきつれ故郷の背戶のみかんの色づく頃をと弟",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0010",
   "pid": "1090532",
   "pages": [
    17
   ],
   "no": null,
   "maki": "兄と弟",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "弟のみとりするとてあさあさを米とぎにけり露霜おくにうすら寒き洋燈のほかげにかがなへて都にかへる日の待ち遠き新しき洋燈買ひゆき灯ともせば飽かずみてゐる兄のかほはも新しきらんぷともせば近所の子等集りて來る忙はしき土間に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0011",
   "pid": "1090532",
   "pages": [
    18
   ],
   "no": null,
   "maki": "旅にいでて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕さむき渚に立てば沖の海の小富士の島に波のよるみゆ、柿の實のうれたるみつつふるさとの門べに立ちて今はうれしき旅にして思ひはまさる十一月の夕空やけて風のわたれば旅にいでて",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0012",
   "pid": "1090532",
   "pages": [
    19
   ],
   "no": null,
   "maki": "旅にいでて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "蜜柑むきつつひとりを嘆き山道のかたむきそめし日かげふみしむ宇和島の港にはてし船の上に木の葉ふき返す山よりのかぜ思ひくし旅にいづればわが心つげたきほどの雨はふりつつ旅すれば人のこひしくなりにけり空には赤き夕やけのして",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0013",
   "pid": "1090532",
   "pages": [
    20
   ],
   "no": null,
   "maki": "母の歌",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "母の歌遠ゆきし母が手植ゑの韮の花今はさかりとなりにけるかも裏畑にかたまりて咲くしら花の韮の花かなし夕雨の中に韮の花しろきを見れば幼などち髮にかざせし昔こほしき25",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0014",
   "pid": "1090532",
   "pages": [
    21
   ],
   "no": null,
   "maki": "新月",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "海越えて歸りは來つれふるさとの生れし家に母はいまさずたらちねの母まさぬ家にかへりきて夕べ淋しらんく洋燈をともす新月のほの明るきに面ふせて語りし人の忘られなくにぶ新月",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0015",
   "pid": "1090532",
   "pages": [
    22
   ],
   "no": null,
   "maki": "秋風",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "梅雨空をりをり晴れて陽の光り夾竹桃の花にうごけりなくなへに蛙の小腹ふくらみてしばしば葉よりすべらむとする秋大根のたねをまかなと思ひつつ彼岸もすぎて秋ふけにけり風",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0016",
   "pid": "1090532",
   "pages": [
    23
   ],
   "no": null,
   "maki": "葛飾",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "秋風ははやたちぬらし夕畑にもろこしの葉のさやぐを聞けば葛蛙なくこゑを聞きつつ停車場の柵にもたれて人まつわれは飾",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0017",
   "pid": "1090532",
   "pages": [
    24
   ],
   "no": null,
   "maki": "葛飾",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "葛飾の早苗水田の細道を君としあゆむ夕べやすけし君まつと停車場にゆく小野のみち蛙田になく夕べなりけり葛飾に住ひてひとをまつからに夕蛙小田になけばたぬしも夕闇に人まちをれば垣のへのくちなしの花匂ひ來るかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0018",
   "pid": "1090532",
   "pages": [
    25
   ],
   "no": null,
   "maki": "葛飾",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "さまよひてここには來つれ山梔の花ほのしろき生垣のあたり來るひとを幾日待ちけむ門の外に今宵もひとり我が立ちつくす別れきてかへる夜道にしらじらと木犀の花ちりゐたりけりあはむ日をおもひたへつつここに來しわが目にいたき野苺の花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0019",
   "pid": "1090532",
   "pages": [
    26
   ],
   "no": null,
   "maki": "葛飾",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "先生の家にとなりてわが住めば夜學の子らの本よむがきこゆ東京の人きたれりと近所の子らさはぎ集るわが宿の庭に朝はしもとく起きいでて脊戶川の水汲む人に我も交りて沼のべにむら生ひしげる女竹やぶよしきりの聲そこより聞ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0020",
   "pid": "1090532",
   "pages": [
    27
   ],
   "no": null,
   "maki": "秋の夕べ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "蓮の葉を笠にしてあゆむ畔のみち燕はあまたとびゐたるかも蜻蛉つる子等に交りてけふもまた遠田にきつれ垂穗のさやぎ秋野に立ちて何をもとめむこの心芒靑原かぜのわたればの夕べ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0021",
   "pid": "1090532",
   "pages": [
    28
   ],
   "no": null,
   "maki": "秋の夕べ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "この心ひとにつげむと思へかも夕野にたちて入りつ陽をみる垂り枝はつゆしとどなり露おけば土にとどきて咲きし萩かも山はぎははやも咲きたり思ひくし我がゆくみちの夕かげにして",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0022",
   "pid": "1090532",
   "pages": [
    29
   ],
   "no": null,
   "maki": "いでゆ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "でゆはるばると旅に來しかも上つ毛の赤城山根を目の前にみつみどり透く廣葉の中にかたまりて桐の實たれたりみな露もちていが栗のまだやわらかき靑とげを掌にさやりつつ行く峽の徑い",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0023",
   "pid": "1090532",
   "pages": [
    30
   ],
   "no": null,
   "maki": "山川の曲（大正十年―十一年）",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕されば木ぬれもしじにひぐらしのこゑすみわたる山のいでゆにゐろりべにまとゐてすする朝の茶のこころしたしも山のいでゆにいとしづかに列はあゆめりうちなびく都大路山川の曲",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0024",
   "pid": "1090532",
   "pages": [
    31
   ],
   "no": null,
   "maki": "葵祭",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "47に立ちて久しもいにしへの葵まつりをみんものと加茂の河原葵祭",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0025",
   "pid": "1090532",
   "pages": [
    32
   ],
   "no": null,
   "maki": "葵祭",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あゆみ來る牛車のきしり春の日にひびきてよけふはしも裝ひよろしく引く牛のあゆみはおろし加茂の祭りはに埃もたたず",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0026",
   "pid": "1090532",
   "pages": [
    33
   ],
   "no": null,
   "maki": "寂しさ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "寂しさ人まちてはかなき宵をさまよへばこひしき方に灯のとぼりつつ來るといふに終ひに來らずわがこころ空しくなりて小床をしくもさびしらに我が生くるものを秋の日の日向ながらに小雨はふるも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0027",
   "pid": "1090532",
   "pages": [
    34
   ],
   "no": null,
   "maki": "犬吠岬",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "このひるを陽はてりながら小雨ふり會ひたきそし車のひびき吠曇りひくき燈臺下の岩の間に寄る波靑し音の高しも心しきりにわき來る犬岬",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0028",
   "pid": "1090532",
   "pages": [
    35
   ],
   "no": null,
   "maki": "犬吠岬",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "見はるかす沖のはたてにをりをりをしぶき上がれり岩あるらしも友としてゆくこの濱はくれにけり砂ふみしめてただにあゆむも外海の荒波よするしぶきかも岸べの草はみな濡れてをり銚子のや風たちくれば波を荒み磯曲かすめて潮けむりたつ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0029",
   "pid": "1090532",
   "pages": [
    36
   ],
   "no": null,
   "maki": "唐津",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "唐津つくしがた唐津の町に夜つきて山々にもゆる野火をみにけり燃えさかる山やく野火を見つつゐてつくし訛りもきくにうれしき近き山にもえゆく野火は窓にはえふたりしたしき夕餉ををすも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0030",
   "pid": "1090532",
   "pages": [
    37
   ],
   "no": null,
   "maki": "虹の松原",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "虹の松原ふたりしてゆくに親しき松原や日かげうららに春の日はたけうつ波もしづかに來寄れ春の濱ふたり歩みてこころ安けしむきむきに海にそむける松低く白砂にとほく春日かげろふ59",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0031",
   "pid": "1090532",
   "pages": [
    38
   ],
   "no": null,
   "maki": "伯父逝く",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "伯父逝くわが恩人なるなつかしき伯父、六月十七日赤十字病院に逝く、息の絕ゆるきはまでも言ふは唯政治と政友のことのみ衰へし顏をまもりておのづから涙はわくも死にゆくひとにく苦しむ伯父を死にてゆくいまわの際も聲を斷たず言ひけることは國のまつりごと",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0032",
   "pid": "1090532",
   "pages": [
    39
   ],
   "no": null,
   "maki": "伯父逝く",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "まつりごと消ぬるがに聲は細れど政治國のことただにいひし伯父はも死にてゆく人のいまはの言の葉を遺さんものと書くペンの音言ひのこさん言はいまだもつきぬまに口動かして死にし伯父はも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0033",
   "pid": "1090532",
   "pages": [
    40
   ],
   "no": null,
   "maki": "天城山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "天城山登り來て見下す天城の山なだり合歡の花あまた陽にてりゐるもふりさけて我が見る伊豆の群山に霧立ちわたる雨となるらし木立ふかき天城の山にかかる雲をりをりふり來霧雨となりて65",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0034",
   "pid": "1090532",
   "pages": [
    41
   ],
   "no": null,
   "maki": "天城山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山裾の谷の低きに風たちてみな靡きをり靑田の稻は天城ねに風たちわたり並みたてる杉の群秀をどよもしすぐる道もせの秋草におく露しげし麓はいまだ夕べはやきに夕まけて天城の山に生ふる杉のうれ動きやまず風立つらむか",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0035",
   "pid": "1090532",
   "pages": [
    42
   ],
   "no": null,
   "maki": "湯ケ島",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "空かぎる天城の山は木を深み今宵の月にくろぐろと立つ玉の〓の命のかぎり生きんとてか引く息なが宵早く戶をさし眠る家多しこの街道の夜のしづもり湯ケ島",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0036",
   "pid": "1090532",
   "pages": [
    43
   ],
   "no": null,
   "maki": "湯ケ島",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "瀨音たかき谷川にてる月夜なり光りくだけて岩越す水は湯ヶ島の吊橋渡り見上げたる山柿の實はいまだ靑しも天城嶺に風たちくれば木立多みどよもす音のここまで聞ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0037",
   "pid": "1090532",
   "pages": [
    44
   ],
   "no": null,
   "maki": "赤倉",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "空かぎる妙高山の山裾のなだりはながし北に向ひて山々のかさなり深し越後のや黑姫山は裾ながく引き關川は越後の國とみすずかる信濃の國を分けながれたり赤倉",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0038",
   "pid": "1090532",
   "pages": [
    45
   ],
   "no": null,
   "maki": "赤倉",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山の上は秋風はやし靑茅がや八月にしてみな穗にいでたり宵月夜かや原こめて照りあはしはるかにたつは米山の峰秋の風けさを俄かに吹き來たり神奈山晴れてけざやかに立つ月の夜は山の低くどにかがやきて野尻の湖はひんがしに見ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0039",
   "pid": "1090532",
   "pages": [
    46
   ],
   "no": null,
   "maki": "赤城山に登る",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "赤城山に登る木洩れさす月のあかりにけぬの山いく重まがりをこえて來にけりはれし夜の月はてらせどわれらゆく谷ふかくしてひかりとどかず疲れはてもだしてあゆむ谷のみち夜空に仰ぐ星のかがやき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0040",
   "pid": "1090532",
   "pages": [
    47
   ],
   "no": null,
   "maki": "赤城山に登る",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "やうやくにつきたる宿は山の湯の土問の戶さして寢てゐたりけり(梨木溫泉)秋山は名しらぬ草の花さきて木々はいろづくあかるき眞日に笹鳴りの音をききつつのぼりゆくもみぢ下照る赤城の山坂秋がすみ和田なすをちに利根の川西日をうけて光りながれたり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0041",
   "pid": "1090532",
   "pages": [
    48
   ],
   "no": null,
   "maki": "赤城山に登る",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "茶の木畑の峠にたちて見はるかす山なみの上に富士は晴れたり大沼にこぐ櫓の音は白樺の森にひびきて夜はふけたる黑檜嶺ゆ吹き下ろす風にかたよりて沼の上さむくなびきたつ霧みちのへの通草とりつつおのづからこほしさまされり秋日てる山に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0042",
   "pid": "1090532",
   "pages": [
    49
   ],
   "no": null,
   "maki": "赤城山に登る",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "日を重ね別れゐるとも秋草のほそき命をまもりてゆかむかなしさに淚ながして上るみち明るきかもよこの秋山はわがひとり見るに堪へめや赤城ねの毛欅の林のあかるき紅葉山の野にたてばおもひぞせまりくる宵草の葉にみな露もちて",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0043",
   "pid": "1090532",
   "pages": [
    50
   ],
   "no": null,
   "maki": "南の海",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "南箱根山やまをたかみか麓べはいまだもふらぬ雪つもりをり磯の家に灯はともりたりみじか日の海のあかりの殘るあはれさ冬の波よる秀がしらのましろけれくれなづみつつ風のつのればの海",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0044",
   "pid": "1090532",
   "pages": [
    51
   ],
   "no": null,
   "maki": "南の海",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨ぐもの海よりはれて沖の島による波の秀の魚干せる街かへりつつさみしけれ曇れる空は陽にかがやけるはかげりたり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0045",
   "pid": "1090532",
   "pages": [
    52
   ],
   "no": null,
   "maki": "生くる命",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "生くる命秋の日のはれ渡りたる陽のひかり遠樹にふりて人のこひしきいよいよ重く生きむことのうれしさにゐるもまことわれひとの命のかなしきがためいさかひしままにわかれていく日か寂しさにをりくるしきものを",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0046",
   "pid": "1090532",
   "pages": [
    53
   ],
   "no": null,
   "maki": "生くる命",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いでていにし君がうしろ手思ひつつ庭に下りたてば宵月のかげねぎ畑のうねま正しき畑にたちくれゆくそらをみてゐたりけり病むといへば逢はむ日遠しこの夕べわが庭のへの草ぬきにつつせつなさの身にせまり來ぬ山吹の花の垂り枝に雨ふるみれば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0047",
   "pid": "1090532",
   "pages": [
    54
   ],
   "no": null,
   "maki": "月夜",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "こひいのる事のみ多し夕されば心やりかね灯にすわりたり石垣に干し並べたる魚くづの匂ふ街なみに陽ひんがしの空あかるみて二人ゐる小徑ほのかに月夜となれり月夜",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0048",
   "pid": "1090532",
   "pages": [
    55
   ],
   "no": null,
   "maki": "ひとり居（大正十二年―大正十三年）",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ひ野に立ちて久しくなれり眼をあげて月の明るむ空をみにけりとり居",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0049",
   "pid": "1090532",
   "pages": [
    56
   ],
   "no": null,
   "maki": "高野山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "高野山悲しき思ひを抱き、寺に籠らむとて高野山に登るひとりのぼる山をたかだかと見あげつつ草履の紐を足にむすべり97",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0050",
   "pid": "1090532",
   "pages": [
    57
   ],
   "no": null,
   "maki": "高野山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "何事も忘れてゆかむ頂きにつづきてしろき山はらのみちしげりふかき山つづきたる紀の國を目下にみつつのぼりゆくなり山中の小學校は夏やすみ門をとざしてしづまりにけり徑をまわればたぎつ瀨川の音たかし木の間をすきてみゆる朱の橋",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0051",
   "pid": "1090532",
   "pages": [
    58
   ],
   "no": null,
   "maki": "高野山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "100空のいろくらくなりしがたちまちに山どよもしてふり來る夕立雲ひくくふりくる雨の凄しさ谷の水音も聞えずなれり溪に冷えし凉風とほる橋の上今は夕立もふりやみにけりふと思ひさみしくなれり山水の岩越す音はたゆる間もなし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0052",
   "pid": "1090532",
   "pages": [
    59
   ],
   "no": null,
   "maki": "高野山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨あとの山の氣ひゆる木下みち雫にぬれてのぼりゆくかも仰ぎみる木ぬれは夕の陽あたれど谷の下みちくらくなりたり高野山にのぼりつきたり雨はれてしづもる山に鐘なりひびくつきいだす鐘なりこもる高野山槇の木立は年古りにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0053",
   "pid": "1090532",
   "pages": [
    60
   ],
   "no": null,
   "maki": "高野山",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鐘がなる夕べの山頂にのぼりつき心おのづからあらたまりたり寺の庭の筧をおつるま〓水にひとりさみしく足を洗へり山の風ふきすぐるなへ夜の蟬羽ばたきなけり庭のしげみに僧院にこもり我がをれば小夜くだちあらしの風はをりをりすぐる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0054",
   "pid": "1090532",
   "pages": [
    61
   ],
   "no": null,
   "maki": "嶽辨天に登る",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "小夜あらし夜ごとをふきて山ふかき高野の山は秋たちにけり山の上の町は戶ざして靜もれり屋根も木立も明るき月かげ見下ろせば紀の川面にわく雲は吉野の山の奥につづけり嶽辨天に登る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0055",
   "pid": "1090532",
   "pages": [
    62
   ],
   "no": null,
   "maki": "病む日",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "109き上り見ゆ川の面に雲たちわたり向つ嶺の吉野の山は浮にのびつつ病ひえてこころ弱れり窓の外の欅の新芽日每む病日",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0056",
   "pid": "1090532",
   "pages": [
    63
   ],
   "no": null,
   "maki": "病む日",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "床の中に目覺めてさびし日のくれの街のもの音賑かに聞ゆ告げたき心押へていく日かも夕べとなれば熱いでにけり會ふ日まで生きがたき身と思ひつつ訪ひ來し友にことづてをせりよわるこころをひとり引きしめて汗ばめる肌のあつきに眼をつぶる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0057",
   "pid": "1090532",
   "pages": [
    64
   ],
   "no": null,
   "maki": "さかりすみて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "112みづからの力をたへて一すぢに生きんと思ふこころさぶしさ何がなし夫の香のこるなつかしさ緣の日向に衣をときつつさかりすみて",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0058",
   "pid": "1090532",
   "pages": [
    65
   ],
   "no": null,
   "maki": "ひとり居",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "114外つ國も秋さびつらむ我がひとりもみづる木々の山々をみて西空に陽はおちたればなみよろふ山際いよいよ澄みきはまれり夕づけばこころ忙しく戾りきてあかりのもとにひとり坐れりひとり居",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0059",
   "pid": "1090532",
   "pages": [
    66
   ],
   "no": null,
   "maki": "ひとり居",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ひとりゐて心落ちゐずいでてくればゆききの電車灯をともしたりけふの日も夕べとなれり巷には明るき電車いくつも走る電車下り歸りを急ぐ人のかほわれはみてたつ夕の巷にひとりたつ我にかかはりなし滿員の電車目の前をつぎつぎ去るも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0060",
   "pid": "1090532",
   "pages": [
    68
   ],
   "no": null,
   "maki": "家居",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "121の風吹きてをり住まはむとひとり來れる奈良山にはやくも秋家居",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0061",
   "pid": "1090532",
   "pages": [
    69
   ],
   "no": null,
   "maki": "家居",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "み山べのふもとにひとり家居して夕べかなしき灯をともすかもみ陵に間近く住みて夜半にきく松風の音はしづかなりけりみ陵の松ふく風をききゐつつ心は深くひとを思へりひとりゐのこころ堪へつつ戾り來し部屋に明るき月かげさせり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0062",
   "pid": "1090532",
   "pages": [
    70
   ],
   "no": null,
   "maki": "友の寺を訪ふ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "木々の上にはるかに見ゆる塔の尖そがひの空は夕やけにけり大寺の庫裡の廣間に夜を更かし友と語れば月の出となれり友の寺を訪ふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0063",
   "pid": "1090532",
   "pages": [
    71
   ],
   "no": null,
   "maki": "友の寺を訪ふ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "126大寺をいづれば秋のよる更けて月は三笠の上にのぼれり夜の道を友としかへる春日野に月は明るくてり渡るかも春日野の細徑あゆむ我が裾に靑かや草のしきりにさやる草原のくまなき明り身にたへてただあゆみをり友のあとより",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0064",
   "pid": "1090532",
   "pages": [
    72
   ],
   "no": null,
   "maki": "友の寺を訪ふ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "送られてかへる春日のしろきみちはるかにとほき人を思へりふり仰ぐ戒壇院のきざはしに月かげ更けて動かざりけり街の灯のつづく丘べに友と別れひとりさびしく家にかへるも靜かなる街にさやけき月のかげ友の下駄音次第にとほし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0065",
   "pid": "1090532",
   "pages": [
    73
   ],
   "no": null,
   "maki": "或時に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "130街をこえてま向ひに見ゆる生駒山月照り更けてまたたくともしび街に入れば心いよいよさぶしかり家の戶洩るるともしびの影或時おのづからこほしさわけり部屋の中にさし入る月の明るきにゐて131に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0066",
   "pid": "1090532",
   "pages": [
    74
   ],
   "no": null,
   "maki": "大極殿の跡にて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "逢ふべくはまことに遠し緣に出てすみゆく月をひとり仰げり身にしみて秋風とほるさびしさよ着物のえりのよごれふきつついにしへの宮居の跡に來て見れば草の穂ほけて風に靡けり大極殿の跡にて",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0067",
   "pid": "1090532",
   "pages": [
    75
   ],
   "no": null,
   "maki": "大極殿の跡にて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "宮柱たてつらねたらん古へのいしずゑ今にのこる尊さ秋の日はしみらに照れり原中にのこる石ずゑ空しかりけり見返れば三笠の山にならびたつ大佛殿の屋根の大きさわえ三笠山は小さくし見ゆ大佛殿黃金の鵄尾は陽にかがやきて",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0068",
   "pid": "1090532",
   "pages": [
    76
   ],
   "no": null,
   "maki": "三笠山に登る",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "見下ろせば里わくらみて夕かしぐ煙いくすぢもたちのぼるなり山の上はいまだ明るし田の中を走る電車は灯をともしたり見下ろせば塔も木立も低くして大佛殿建てり屋根のひろさよ三笠山にのぼる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0069",
   "pid": "1090532",
   "pages": [
    77
   ],
   "no": null,
   "maki": "唐招提寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "唐招提寺門にたてばあたりしづけし遠くにて蜻蛉つる子のこゑきこえくる圓柱は位置を保ちて並びたり唐招提寺の屋根の重たさ境內のもの靜かさよ步み入る足音たかくこだましにけり139",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0070",
   "pid": "1090532",
   "pages": [
    78
   ],
   "no": null,
   "maki": "唐招提寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大きなる扉ひらけばしめやかに土の匂ひのただよひ來るも講堂の扉を洩るる弱き陽にむきむきにならぶみ佛のかほ小暗きにみ佛のかほを見守れば古きいのちはしづかなりけり堂をいづれば廣庭にたかき赤松の梢あかるく夕日あたれり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0071",
   "pid": "1090532",
   "pages": [
    79
   ],
   "no": null,
   "maki": "法隆寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "驛をいづれば田中のみちは一筋に斑鳩寺の塔塔にむかひひとりし行けば晝ながら法隆寺村法隆143にむかへりはしづかなるかも寺",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0072",
   "pid": "1090532",
   "pages": [
    80
   ],
   "no": null,
   "maki": "當麻寺へ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "當麻寺へ畔みちにたてばはるかに當麻の塔二上山のやまもとに見ゆ葉をおとしあらはになりたる木々の上に當麻の塔は二つならべり夕づきて寒くしなれるかへり路の田川の水は澄みとほりたり145",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0073",
   "pid": "1090532",
   "pages": [
    81
   ],
   "no": null,
   "maki": "二月堂夜詣り",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夜詣りの人に交りてわれもゆく夕やみ深き春日のみちをteb石段の下より仰ぐ二月堂屋根まで明るし燈火のかずぶつ)佛燈のあかりとどきて見ゆる限りみ堂も廻廊も夜詣りの人二月堂夜詣り",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0074",
   "pid": "1090532",
   "pages": [
    82
   ],
   "no": null,
   "maki": "淨瑠璃寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "148杉むらに灯かげ明るくけむらへり東大寺の鐘なりこもりつつ初夜の鐘の鳴りひびくなかを二月堂に夜詣りの人らつづきてのぼる丘越しに何時までも見ゆる大佛殿ふりかへりつつ峽を下れり149淨瑠璃寺",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0075",
   "pid": "1090532",
   "pages": [
    83
   ],
   "no": null,
   "maki": "淨瑠璃寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "150ここははや山城ならむ山かひに靑田ひらけて凉風とほれり徑の上におとす陽かげの照りかげりせはしくなれり風もさやげる夕立すぎてすがしき風の通るみち木ぬれの雫しきりにおつる雨あとの空ふかく晴れて山もとの堂塔のやねに雫ひかれり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0076",
   "pid": "1090532",
   "pages": [
    84
   ],
   "no": null,
   "maki": "淨瑠璃寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "庭にたてば池向ふなる三重の塔古さびながらしづくしたたれり塔と堂池をはさみてしづかなり夕立はれしこの山かひにつぎねふ山城のくにの山峽に千年を經たる塔のしづけさ九つの坐像のみ佛ゐならびて天井にとどく頭の大きさよ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0077",
   "pid": "1090532",
   "pages": [
    85
   ],
   "no": null,
   "maki": "多武峰",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "155いよ重し谷川の低きに水の音こもり空のくもりはいよ一列にみ堂にならぶ九つのみ佛の坐像おもおもしかも多武峰",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0078",
   "pid": "1090532",
   "pages": [
    86
   ],
   "no": null,
   "maki": "岡寺より橘寺へ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "多武の蜂にのぼりつきたり山の上はもみぢ明はざま田の棚田の稻は黄に光り麓にとほくひらけたるかもるく秋ふかみたり岡寺より橘寺へ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0079",
   "pid": "1090532",
   "pages": [
    87
   ],
   "no": null,
   "maki": "岡寺より橘寺へ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨雲はひくく下りたりはざま路の柵田の稻のそよぎしるけき岡寺の門への道のきざはしにふる雨の音をききてたちたりうす暗きみ堂の中の大佛我が目とどかずしばし仰げり目になれてややに見えたりみ佛の坐像のみ胸ゆたかなるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0080",
   "pid": "1090532",
   "pages": [
    88
   ],
   "no": null,
   "maki": "岡寺より橘寺へ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "160橘寺の一筋道に音たてて雨ははげしくふりま田をうちてふりつのり來し雨の音黃ばめる稻は土にふしたりかたみにもだして步む日くれ方畝傍の山を目近くにしてかなしさをひとり耐へてふる雨に傘傾けてひたに歩むも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0081",
   "pid": "1090532",
   "pages": [
    89
   ],
   "no": null,
   "maki": "新藥師寺",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "新藥師寺尼寺のつつましき寺のたたずまひ山のふもとに千年をへたる山裾の松にこもれる風の音み寺の庭にたちてききをりしづまれるみ堂の中の藥師如來眼ひらきてただしくおはす163",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0082",
   "pid": "1090532",
   "pages": [
    90
   ],
   "no": null,
   "maki": "馬醉木",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "尼寺のみ堂をいでて近々と高圓山を仰ぎ見にけり古寺にたつきいとなむつつましさ尼はさ庭に醉茂り枝にちりたまりたる馬醉木の葉夕風ふくに落つる音すも張りものをせり馬木165",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0083",
   "pid": "1090532",
   "pages": [
    91
   ],
   "no": null,
   "maki": "法華寺に行く",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "落葉ふる音をききつつ歩み入る竹柏の林はくれて來にけり木の間ふかくさし入る夕陽あはあはし近づき來たる鹿の足音川に添ふ徑のながてに見はるかす山の高根は雪ふりにけり法華寺にゆく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0084",
   "pid": "1090532",
   "pages": [
    92
   ],
   "no": null,
   "maki": "法華寺に行く",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "川岸をひとり靜かに歩みけりみ陵にふく風の音ききつつ尼寺にてりかげる陽をみつつあれば時雨ふりきて屋根をぬらせり夕ちかくひとり來しかば尼寺の屋根うつ時雨の音をききをり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0085",
   "pid": "1090532",
   "pages": [
    94
   ],
   "no": null,
   "maki": "日向和田",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "173さくら花山下に家居したしむ村人等み寺の庭ににほふ日向和田",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0086",
   "pid": "1090532",
   "pages": [
    95
   ],
   "no": null,
   "maki": "日向和田",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "むぎ踏みの人はかへりて晝畑にふまれし麥は右に左に靑むぎと白壁ばかりみゆこの村は春たけなはに靜かなるかも川向ふにならぶ家居のうしろ山竹のそよぎは明るかりけり山もとの竹のそよぎの明るさを川向ふにして見つつあゆめり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0087",
   "pid": "1090532",
   "pages": [
    96
   ],
   "no": null,
   "maki": "五番町",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "176五番町雨あとのゆたかにたたふる濠の水草刈り人は舟にてわたる夏草の土堤ながながと濠水にかげうつしゐる梅雨空のもとほりみづのひとところあはく日光さし土堤の夏草に雨ぞふりゐる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0088",
   "pid": "1090532",
   "pages": [
    97
   ],
   "no": null,
   "maki": "梅雨空",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "178梅雨空松三本うゑしが一本枯れて育たず朝に夕にみるにすべなし秋されば武藏ひろ野の夕風に梢鳴らして生いけむものを梅雨空の時ま晴れわたりかれがれの松に陽ざしの强くあたるも枯れてゆく松の細枝に脂わきて陽にてるみれば何かさぶしき179",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0089",
   "pid": "1090532",
   "pages": [
    98
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夏いささかの務めするとて我もゆく晴れたる空の朝すがしき仕事もちて朝ゆく街のすがしさやことしの夏をわれすこやかに人なみに我も仕事をもてり朝戶出の夫をおくりて心つつまし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0090",
   "pid": "1090532",
   "pages": [
    99
   ],
   "no": null,
   "maki": "或日",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "仕事畢へて思ふことなきうらやすさ凉風とほる部屋に坐りて日曜をひと日留守もるわびしさよ土にひゞきて午砲の音きこゆ大の心うたがひそめて眞夏日のあつきしづもり堪へてわがをり或日",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0091",
   "pid": "1090532",
   "pages": [
    100
   ],
   "no": null,
   "maki": "目黒にて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眞心はかよひ難きぞあきらめて友を送りて門にいでたつひとごとはたのみかねつも夕つ日の友のうしろに照れるさみしさ夜ふけて友としあゆむ競馬場の向ふにあがる花火のあかり目黑にて",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0092",
   "pid": "1090532",
   "pages": [
    101
   ],
   "no": null,
   "maki": "土佐の海",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "がるしぶきの高さ明るむかふにかへり來る道のながての暗の夜花火たまゆら屏風岩たて連ねたる土佐の海のうみぎしにあ土佐の海",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0093",
   "pid": "1090532",
   "pages": [
    102
   ],
   "no": null,
   "maki": "土佐の海",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "屏風岩の上より見れば岩燕飛び交ふはやししぶきにぬれつつ打ちよする波のしぶきは陽に光り外海につづく海の靑さよ靑々と崖下によする海のいろ凄まじくしてつばめ飛び交ふ土佐の海のそとうみはあらしうち寄する潮は群立つ大岩をこせり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0094",
   "pid": "1090532",
   "pages": [
    103
   ],
   "no": null,
   "maki": "島の町",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "190ここに立てば白浪たかし目路とほく太平洋につづく海づらるそさしささしさ外濱の風まともなり斜面の草せたけみじかく花さきてをり島の島の峰にはづかにのこる入陽のいろ漁りの船はみな戾り來る191町",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0095",
   "pid": "1090532",
   "pages": [
    104
   ],
   "no": null,
   "maki": "島の町",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "賑はしき一時すぎてもやふ船にしづかに寄せてかへす浪の音島の町の夜はしづかに更けゆきて魚の匂ひのこもりふかしもこの島の家居はしたし百萬長者の屋根の上にも石ならべたり町中はしづまり返り聞きをれば寄する波音島をつつめり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0096",
   "pid": "1090532",
   "pages": [
    105
   ],
   "no": null,
   "maki": "秋の路",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "194さかり來てふり返りみれば島のかげ小さくなりて海にしづめり(かへり二首)沖風に帆をあげてゆく風ぎ日和漁りの船にいくつもあへり秋陽の入りのもののしづけさ峽間路に見あぐる山はいまだ明るし195路",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0097",
   "pid": "1090532",
   "pages": [
    106
   ],
   "no": null,
   "maki": "小庭",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "196上の田より下田に落す水の音草にこもりて山の靜けさ櫨の實のかそかにふるる音きこゆ埃をさけてみちべに立てば(馬車をさけて)庭一本のかやの木うゑてたかだかと見上ぐる空はよく晴れにけり小",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0098",
   "pid": "1090532",
   "pages": [
    107
   ],
   "no": null,
   "maki": "小庭",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "198遲まきのトマトはあまた實をつけて靑きがままに秋ふけにけり窓のへの今年うゑたる山椿小さき實ひとつつけにけるかも雨晴れて秋ふかまれり庭はぎの花さきながら下葉かれつつ庭すみの白萩の花日毎ちりこのごろさむくなりにけるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0099",
   "pid": "1090532",
   "pages": [
    108
   ],
   "no": null,
   "maki": "朝顏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "町中の草のともしささ庭べに移り來てなく馬追の聲ひとりゐてしづかに聞けば窓のへの山椿の葉におつる雨の音垣根の朝顏の花目にたちて小さくなれり咲き上りつつ朝顏",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0100",
   "pid": "1090532",
   "pages": [
    109
   ],
   "no": null,
   "maki": "晩秋",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨あとのすがれ目につく朝顏の土に近きは實となりにけりよべ吹きし野分の風に朝顏のけさ咲く花は小さくなれり晩朝庭に夫も下りたち草花の種をとるなりはふのやすみ日に203秋",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0101",
   "pid": "1090532",
   "pages": [
    110
   ],
   "no": null,
   "maki": "箱根游行",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "205の庭に明るきに低まりにけりめづらしく夫と籠りてしづかなり秋の陽ざしトンネルを出でて見下ろす目の下の谷川とみ游箱根行",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0102",
   "pid": "1090532",
   "pages": [
    111
   ],
   "no": null,
   "maki": "箱根游行",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "206山の上に靑菜を買ひてもどり來るみちべの木々はみなもみぢせり山の上にはるばる來つつ湧く水の〓水に夕餉の米を洗へりま〓水に米とぎすまし見上ぐればもみぢ明るき夕山となれり湧きいづる山の〓水を鍋にくみ味噌汁つくる夕べつめたき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0103",
   "pid": "1090532",
   "pages": [
    112
   ],
   "no": null,
   "maki": "箱根游行",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "203湯にひたり耳をすませば電車の音山にひびきて遠くにきこゆみち向ふのいでゆの中に我をよぶ友らのこゑ外にいづれば月夜あかるき木下かげ湯の香しはこだましにけりたしく匂ひて來るも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0104",
   "pid": "1090532",
   "pages": [
    113
   ],
   "no": null,
   "maki": "大湧谷に行くとて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "210大湧谷にゆくとて坂の上にふり返り見れば低くなりし山はら明るくみなもみぢせり動きゆく雲のきれまに向つ根のもみづる木々はけざやかなるもふる雨ははげしくなれり今はただ山の茶店に茶をすすりをり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0105",
   "pid": "1090532",
   "pages": [
    114
   ],
   "no": null,
   "maki": "卷末に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "卷末に私が歌を本當に勉强し初めたのは、其の以前大正六年からまだほんの最近、「草の實」創刊の前後からであつた。「草の實」創刊頃までは、嚴密な態度からいへば、見榮や、誇張や虛飾もあつたし、今思ひ出すと心ひそかに赤面する。見榮や、誇張や虛飾もあつたし、お砂糖のやうな甘さもあつて、とにかくどんな態度であつたにせよ、十年の三月頃から私の心の轉換から、大正六年から同十年まではずつと歌を作つてゐた。思想1の急變が來て全く歌が出來なくなり、とう〓〓十三年の秋までは、",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0106",
   "pid": "1090532",
   "pages": [
    115
   ],
   "no": null,
   "maki": "卷末に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "2丸で見返りもしないで過ぎて來た。それが震災の年の九月を中心にして、七ケ月餘りの奈良滯在と、其の間に約一ケ月登つてゐた高野山の靜寂とによつて、私は今迄の作歌態度から別の眞劍な、そして虔ましい歌の生活に歸つてゆくことが出來た。それは其の頃の私の周圍の方々の賜であるとさへ思つてゐる。高野山に登つてゐた間泊めて項いた親王院の生活は、殊に私の心を和やかに導いてくれた。それには水原堯榮氏があつた。氏は高野山きつての人格者といはれてゐる程の方である。心の懷みを持つて登つてゐる私は、奥の院のさえた月に泣き、更けた僧院のやる方ない寂しさにいつも捉はれた。そんな時何も言はず默つて、山では珍らしい紅茶やお菓子を小僧に持たせてよこされたことも再三ではなかつた。私はあの間の短い生活を考へるとき、何時もみ佛に仕へる人の尊さを思ひだす。それから山を下りてから間もなく震災で、其の年の暮れまで奈良に止まつた。奈良にゐる間に、私に芽ばえてゐた佛〓美術へのあこがれを助長して下された方に東大寺の筒井英俊氏がある。私の淺いこれらの智識は、皆同氏の賜であるといつてもよい。何を見てもせつなく悲しくなる其の頃に、筒井氏はお忙しい閑をさかれては私の見知らぬみ佛や、古い建築を見せるために、遠い所までも連れてゆかれた。私は一生懸命に勉强した。藥師寺の橋本管長に紹介して下す",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kitami-shihoko-1090532-0107",
   "pid": "1090532",
   "pages": [
    116
   ],
   "no": null,
   "maki": "卷末に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "つたのも其の頃である。私は一切を忘れて夢中になつて、良に永住しやうかとさへ思つた。斯うした幸福な周園の賜で、私は期せずして又歌の生活に歸つて來ることができたのであつた。斯んな譯で、自分の氣持ちからいへば、「草の實」以前の歌と、其の後の歌とを區別するために、こん度の歌集は「草の實」以前のものばかりにしたかつたのであつたが、故古泉千樫先生をはじめ同人の方も、一緒にした方がよいといはれたので、全部集めることにした。集めて見ると案外歌の數が多く九百首近くになつて了つて、私の豫定の數三百五十首にするのは大ていでなくなつた。どの歌もみんな團栗の脊くらべでうんざりして了つた。それと歌は下手であつても其の歌を作つた時の氣持ちを思ひだして、どうしても捨てることができないのもあつて、豫定數にするには中々容易でなかつたが、兎に角五百首位にして古泉先生の所にお預けした。先生が其の上、選して下さる筈であつたから。所が間もなく先生は御病氣がひどくなられ、二三頁みて頂いたばかりで、遂に亡くなられた。そんな譯で出版が春になり秋となりとうとう今になつて了つた。初めの「早春譜」と「山川曲」とは「草の實」以前の歌で、「那羅」からが「草の實」所載のものである。又「那羅」は作歌順序からい15.中に高野山をはさむのが本當であるけれども、奈良に住つて5",
   "sachu": "",
   "poems": []
  }
 ],
